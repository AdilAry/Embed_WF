#!/usr/bin/env python3
"""bench-ble-scan - scan for BLE advertisers from the dev box.

    bench-ble-scan                    list everything seen in 8 s
    bench-ble-scan --name MyDevice    exit 0 if a device with that name is seen
    bench-ble-scan --seconds 15 --name MyDevice

Uses `bleak` (installed into the Embed_WF venv by devbox/setup-user.sh).
Exit codes: 0 ok/found, 1 not found, 3 bluetooth/bleak problem.
"""

import argparse
import asyncio
import sys

try:
    from bleak import BleakScanner
except ImportError:
    print("bleak missing - run Embed_WF/devbox/setup-user.sh", file=sys.stderr)
    sys.exit(3)


async def scan(seconds: float):
    found = await BleakScanner.discover(timeout=seconds, return_adv=True)
    return [(d.address, d.name or adv.local_name or "", adv.rssi) for d, adv in found.values()]


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-s", "--seconds", type=float, default=8.0)
    ap.add_argument("--name", help="device name to look for (exact match)")
    args = ap.parse_args()
    try:
        devices = asyncio.run(scan(args.seconds))
    except Exception as e:  # BlueZ off, no adapter, permissions ...
        print(f"BLE scan failed: {e}", file=sys.stderr)
        return 3
    for addr, name, rssi in sorted(devices, key=lambda d: -d[2]):
        print(f"{addr}\t{rssi:4d} dBm\t{name}")
    if args.name:
        hit = any(name == args.name for _, name, _ in devices)
        print(f"bench-ble-scan: '{args.name}' {'FOUND' if hit else 'NOT FOUND'}")
        return 0 if hit else 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
