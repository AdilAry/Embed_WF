{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(arduino-cli:*)",
      "Bash(python3 tools/esp_serial.py:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(bench-wifi:*)",
      "Bash(bench-mqtt:*)",
      "Bash(bench-ble-scan:*)",
      "Bash(pdftotext:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Read(./firmware/src/secrets.h)",
      "Read(./.env)"
    ]
  }
}
